{
  "schema_version": 1,
  "record_type": "clear-technical-writing-evaluation-capture",
  "aggregation": {
    "scope": "single-fixture-run",
    "confirms_capability_suite": false
  },
  "required_fields": [
    "schema_version",
    "record_type",
    "fixture_id",
    "evidence_class",
    "trial_run_id",
    "skill_revision",
    "model_id",
    "runtime_id",
    "outer_instructions",
    "source_packet_hash",
    "generation_settings",
    "tool_context_configuration",
    "trial_count",
    "timestamps",
    "output",
    "scorecard",
    "status",
    "observable_trace",
    "commissioning_protocol"
  ],
  "timestamp_fields": ["prepared_at", "completed_at"],
  "status_rules": {
    "prepared": {
      "evidence_classes": ["controlled-model", "blinded-human"],
      "requires_output": false,
      "requires_score": false,
      "requires_completed_at": false
    },
    "current": {
      "evidence_classes": ["controlled-model", "blinded-human"],
      "requires_output": true,
      "requires_score": true,
      "requires_completed_at": true
    },
    "product-contract-failure": {
      "evidence_classes": ["controlled-model", "blinded-human"],
      "requires_output": true,
      "requires_score": true,
      "requires_completed_at": true
    },
    "model-capability-unconfirmed": {
      "evidence_classes": ["controlled-model"],
      "requires_output": false,
      "requires_score": false,
      "requires_completed_at": true,
      "failure_kinds": [
        "authentication-or-configuration-failure",
        "provider-or-infrastructure-failure",
        "inconclusive-timeout"
      ]
    },
    "capability-unconfirmed": {
      "evidence_classes": ["controlled-model"],
      "requires_output": false,
      "requires_score": false,
      "requires_completed_at": true,
      "failure_kinds": [
        "authentication-or-configuration-failure",
        "provider-or-infrastructure-failure",
        "inconclusive-timeout"
      ]
    },
    "human-comprehension-unconfirmed": {
      "evidence_classes": ["blinded-human"],
      "requires_output": false,
      "requires_score": false,
      "requires_completed_at": true,
      "failure_kinds": [
        "missing-evaluators",
        "provider-or-infrastructure-failure",
        "inconclusive-sample"
      ]
    }
  },
  "scorecard_required_fields": [
    "criteria",
    "overall_passed",
    "first_failed_contract",
    "first_failure_boundary"
  ],
  "criterion_result_required_fields": ["criterion_id", "passed", "evidence"],
  "trace_event_required_fields": [
    "sequence",
    "case_id",
    "event_type",
    "actor_id",
    "run_id",
    "timestamp",
    "artifact_ref",
    "details"
  ],
  "forbidden_private_fields": [
    "chain_of_thought",
    "private_reasoning",
    "private_plan",
    "hidden_reasoning",
    "scratchpad"
  ]
}
